# Optional: leave empty to use test mode without AI calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Service authentication: separate from the OpenAI key. Set a secret before production startup.
AI_AGENT_SECURITY_ENABLED=true
AI_AGENT_API_KEY=
AI_AGENT_API_KEY_ID=internal-test
AI_AGENT_RATE_LIMIT_ENABLED=true
AI_AGENT_RATE_LIMIT_PER_MINUTE=30

# Published host address and port. Container port remains 8081.
HOST_ADDRESS=127.0.0.1
HOST_PORT=8081
